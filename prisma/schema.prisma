// Cdrive — kurumsal dosya yönetim platformu veritabanı şeması

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
  // "native" — Windows'ta yerel geliştirme için. "linux-musl-openssl-3.0.x" —
  // Docker/VDS deploy'u (Dockerfile'daki Alpine runner image'ı OpenSSL 3.0.x
  // ile geliyor; bu hedef olmadan Prisma "generic" bir motor üretiyor ve
  // runtime'da "could not locate the Query Engine" hatasıyla patlıyor —
  // gerçek Docker deploy'unda yakalandı).
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN // her şeye erişim, kullanıcı/departman yönetimi
  MANAGER // kendi departmanının tüm dosyalarını yönetir
  MEMBER // sadece kendi dosyaları + kendisiyle paylaşılanlar
}

enum Permission {
  VIEW
  EDIT
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  UPLOAD
  DOWNLOAD
  DELETE
  RESTORE
  RENAME
  MOVE
  CREATE_FOLDER
  SHARE_CREATE
  SHARE_REVOKE
  PERMISSION_GRANT
  PERMISSION_REVOKE
  USER_CREATE
  USER_UPDATE
  USER_DEACTIVATE
  DEPARTMENT_CREATE
  DEPARTMENT_UPDATE
  STAR
  UNSTAR
  PURGE
  TWO_FACTOR_ENABLE
  TWO_FACTOR_DISABLE
  PASSWORD_CHANGE
  SESSION_REVOKE
  SETTINGS_UPDATE
  AUTO_CLEANUP
  ORDER_CREATE
  ORDER_STATUS_UPDATE
  PAYMENT_RECORD
  PAYMENT_DELETE
  CUSTOMER_AUTO_UPDATE
  IMPERSONATE_START
  IMPERSONATE_STOP
}

enum NotificationType {
  SHARE_GRANTED
  QUOTA_WARNING
  ORDER_CREATED
  ORDER_STATUS_CHANGED
  PAYMENT_RECORDED
  ORDER_OVERDUE
}

enum PaymentMethod {
  CASH // Nakit
  BANK_TRANSFER // Havale/EFT
  CREDIT_CARD // Kredi kartı
  OTHER // Diğer
}

enum OrderStatus {
  PENDING // Beklemede
  APPROVED // Onaylandı
  IN_PRODUCTION // Üretimde — Onaylandı sonrası stok kontrolünde en az bir kalem "Stokta Yok" işaretlenirse buraya düşer
  INVOICED // Faturalandı
  CANCELLED // İptal
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  quotaBytes BigInt  @default(5368709120) // departman varsayılan kota: 5 GB
  createdAt DateTime @default(now())

  users   User[]
  folders Folder[]

  @@map("departments")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(MEMBER)
  active       Boolean  @default(true)
  quotaBytes   BigInt   @default(2147483648) // kullanıcı varsayılan kota: 2 GB
  usedBytes    BigInt   @default(0)
  createdAt    DateTime @default(now())

  // Sipariş kayıt sistemi — departmandan bağımsız, admin panelinden kişi bazlı açılan
  // iki ayrı yetki: pazarlama tarafı (oluşturma) ve muhasebe tarafı (yönetme).
  canCreateOrders Boolean @default(false)
  canManageOrders Boolean @default(false)
  // Stoklu mal üretimi: bir siparişteki kalemlerin stok durumunu (Var/Yok) işaretleyip
  // "Üretimde" aşamasını yönetebilir — canManageOrders'tan bağımsız, ayrı bir yetki
  // (üretim ekibi, muhasebeden farklı kişiler olabilir).
  canManageProduction Boolean @default(false)

  // İlk giriş kurulumu — admin tarafından oluşturulan hesaplarda true başlar: kullanıcı ilk
  // girişte kendi şifresini belirleyip bir avatar seçene kadar /onboarding'e yönlendirilir.
  mustChangePassword Boolean @default(false)
  // Özellik turu (sistemdeki bölümleri tanıtan bir kerelik modal) — bu alan eklendiğinde
  // TÜM mevcut kullanıcılarda default false olarak başlar (bu yüzden herkes bir sonraki
  // girişte bir kereliğine otomatik görür), yeni kullanıcılar da doğal olarak false ile
  // başlar. Kapatınca true'ya çekilir (bkz. POST /api/account/feature-tour); Hesap
  // Ayarları'ndaki "tekrar göster" butonu bu alana dokunmadan sadece istemci tarafında
  // tekrar açar.
  hasSeenFeatureTour Boolean @default(false)
  avatarKey          String? // ESKİ preset emoji-avatar seti (bkz. src/lib/avatars.ts) — geriye dönük uyumluluk için
  // YENİ çok parçalı "memoji" tarzı avatar — JSON: {skin,hair,eyes,mouth,accessory}
  // (bkz. src/lib/avatar-parts.ts). Doluysa Avatar bileşeni bunu avatarKey'e tercih eder.
  avatarParts        String? @db.Text

  // Güvenlik: 2FA (TOTP) ve başarısız giriş kilitleme
  twoFactorSecret      String?
  twoFactorEnabled     Boolean   @default(false)
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  ownedFolders Folder[]      @relation("FolderOwner")
  ownedFiles   File[]        @relation("FileOwner")
  fileVersionsUploaded FileVersion[]
  filePermissions FilePermission[] @relation("FilePermissionUser")
  folderPermissions FolderPermission[] @relation("FolderPermissionUser")
  shareLinks   ShareLink[]
  auditLogs    AuditLog[]
  fileStars    FileStar[]
  folderStars  FolderStar[]
  notifications Notification[]
  sessions     Session[]
  fileComments FileComment[]
  groupMemberships GroupMember[]
  templateMemberships PermissionTemplateMember[]
  ordersCreated Order[] @relation("OrderCreatedBy")
  ordersUpdated Order[] @relation("OrderUpdatedBy")
  paymentsRecorded Payment[] @relation("PaymentRecordedBy")

  // Kurum içi sohbet (beta) — kanallar + birebir mesajlaşma, bkz. ChatChannel/ChatMessage.
  chatChannelsCreated  ChatChannel[]   @relation("ChatChannelCreatedBy")
  chatMessagesSent     ChatMessage[]   @relation("ChatMessageSender")
  chatMessagesReceived ChatMessage[]   @relation("ChatMessageRecipient")
  chatReadStates       ChatReadState[]

  @@map("users")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?   @db.Text
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
  @@map("sessions")
}

/// Tek satırlık genel sistem ayarları — id her zaman 1.
model SystemSettings {
  id                   Int      @id @default(1)
  trashRetentionDays   Int? // null = çöp kutusu otomatik boşaltılmaz
  versionRetentionDays Int? // null = eski dosya versiyonları otomatik silinmez
  maxFileSizeBytes     BigInt? // null = sınır yok
  blockedExtensions    String? @db.Text // virgülle ayrılmış, örn ".exe,.bat,.sh"
  uiSkin               String   @default("modern") // "modern" | "archive" — Sürücü sayfasının görsel dili, admin panelinden seçilir
  updatedAt            DateTime @updatedAt

  @@map("system_settings")
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  parentId String?
  parent   Folder?  @relation("FolderTree", fields: [parentId], references: [id])
  children Folder[] @relation("FolderTree")

  ownerId String
  owner   User   @relation("FolderOwner", fields: [ownerId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  files       File[]
  permissions FolderPermission[]
  stars       FolderStar[]
  tags        FolderTag[]

  @@index([parentId])
  @@index([ownerId])
  @@map("folders")
}

model File {
  id          String   @id @default(cuid())
  name        String
  mimeType    String
  size        BigInt
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  folderId String?
  folder   Folder? @relation(fields: [folderId], references: [id])

  ownerId String
  owner   User   @relation("FileOwner", fields: [ownerId], references: [id])

  currentVersionId String? @unique
  currentVersion   FileVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  // Yüklenirken çıkarılan düz metin içeriği (pdf/metin dosyaları) — tam metin aramada kullanılır.
  searchText String? @db.Text

  versions    FileVersion[]     @relation("FileVersions")
  permissions FilePermission[]
  shareLinks  ShareLink[]
  stars       FileStar[]
  tags        FileTag[]
  comments    FileComment[]
  orderAttachments OrderAttachment[]
  chatMessages ChatMessage[]

  @@index([folderId])
  @@index([ownerId])
  @@index([name])
  @@fulltext([searchText])
  @@map("files")
}

model FileStar {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileId    String
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, fileId])
  @@map("file_stars")
}

model FolderStar {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId  String
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, folderId])
  @@map("folder_stars")
}

/// Şirket genelinde paylaşılan bir etiket taksonomisi — herkes oluşturup dosya/klasöre uygulayabilir.
model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())

  fileTags   FileTag[]
  folderTags FolderTag[]

  @@map("tags")
}

model FileTag {
  id     String @id @default(cuid())
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  fileId String
  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([tagId, fileId])
  @@map("file_tags")
}

model FolderTag {
  id       String @id @default(cuid())
  tagId    String
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  folderId String
  folder   Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@unique([tagId, folderId])
  @@map("folder_tags")
}

model FileVersion {
  id           String   @id @default(cuid())
  versionNo    Int
  storageKey   String   // diskteki fiziksel dosya adı (uuid)
  size         BigInt
  checksum     String?
  createdAt    DateTime @default(now())

  fileId String
  file   File   @relation("FileVersions", fields: [fileId], references: [id], onDelete: Cascade)

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  currentFor File? @relation("CurrentVersion")

  @@unique([fileId, versionNo])
  @@map("file_versions")
}

model FilePermission {
  id         String     @id @default(cuid())
  fileId     String
  file       File       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation("FilePermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @default(VIEW)
  createdAt  DateTime   @default(now())

  @@unique([fileId, userId])
  @@map("file_permissions")
}

model FolderPermission {
  id         String     @id @default(cuid())
  folderId   String
  folder     Folder     @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation("FolderPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @default(VIEW)
  createdAt  DateTime   @default(now())

  @@unique([folderId, userId])
  @@map("folder_permissions")
}

model ShareLink {
  id        String   @id @default(cuid())
  token     String   @unique
  fileId    String
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  expiresAt DateTime?
  maxDownloads Int?
  downloadCount Int @default(0)
  revoked   Boolean  @default(false)
  passwordHash String?
  createdAt DateTime @default(now())

  @@map("share_links")
}

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  detail    String?     @db.Text
  targetType String?
  targetId   String?
  ip         String?
  createdAt DateTime    @default(now())

  userId String?
  user   User?  @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  targetType String?
  targetId   String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@map("notifications")
}

/// Bir dosya üzerine bırakılan yorumlar — ekip içi tartışma/geri bildirim için.
model FileComment {
  id        String   @id @default(cuid())
  fileId    String
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  createdAt DateTime @default(now())

  @@index([fileId])
  @@map("file_comments")
}

/// Kullanıcı grupları — izin şablonlarında ve doğrudan paylaşımlarda "kime" sorusunu
/// tek tek kullanıcı yerine bir grup adıyla cevaplamak için.
model Group {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  members             GroupMember[]
  templateMemberships PermissionTemplateMember[]

  @@map("groups")
}

model GroupMember {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

/// Hazır izin şablonu: bir izin seviyesi + üye listesi (kullanıcı ve/veya grup) — bir
/// dosya/klasöre tek tıkla uygulanır, üyeler değişse bile şablon adı sabit kalır.
model PermissionTemplate {
  id         String     @id @default(cuid())
  name       String     @unique
  permission Permission @default(VIEW)
  createdAt  DateTime   @default(now())

  members PermissionTemplateMember[]

  @@map("permission_templates")
}

model PermissionTemplateMember {
  id         String              @id @default(cuid())
  templateId String
  template   PermissionTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId    String?
  group      Group?              @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("permission_template_members")
}

/// Pazarlamanın müşterileri için açtığı sipariş kaydı — muhasebeye iletilir, sadece
/// canCreateOrders/canManageOrders yetkisi olanlar (ve admin) görebilir. Dosya sistemindeki
/// klasör/dosya izin modelinden bağımsız, ayrı ve daha basit bir yetki modeli kullanır.
model Order {
  id              String      @id @default(cuid())
  // Kullanıcıya gösterilen kısa, rastgele, en fazla 8 haneli sayısal sipariş/fatura
  // numarası — id (cuid) harf+rakam karışık ve uzun olduğu için Panel/fatura PDF'inde
  // ayrı gösteriliyor. Sadece bu alan eklendikten SONRA açılan siparişlerde dolu olur
  // (bkz. src/lib/orders.ts generateOrderNumber); eski siparişlerde null kalır — o
  // durumda görüntüleme id'den türetilmiş sabit bir 8 haneli sayıya geri düşer
  // (bkz. orderDisplayNumber), veritabanına yazılmaz.
  orderNumber     Int?        @unique
  customerName    String
  customerContact String? // telefon/e-posta, serbest metin
  notes           String?     @db.Text
  status          OrderStatus @default(PENDING)
  accountingNote  String?     @db.Text // muhasebenin eklediği not (onay/red gerekçesi vb.)
  dueDate         DateTime? // vade tarihi — geçip de bakiye kapanmadıysa hatırlatma tetiklenir
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  createdById String
  createdBy   User   @relation("OrderCreatedBy", fields: [createdById], references: [id])

  updatedById String?
  updatedBy   User?   @relation("OrderUpdatedBy", fields: [updatedById], references: [id])

  // Müşteri her zaman customerName/customerContact'a serbest metin olarak da yazılır (sipariş
  // anındaki anlık görüntü); customerId ise aynı isimdeki müşteriyi otomatik bulup/oluşturup
  // bağlar — "Müşteriler" sayfasındaki toplu istatistikler ve geçmiş için kullanılır. Eski
  // (bu alan eklenmeden önce oluşturulmuş) siparişlerde null kalabilir.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  items       OrderItem[]
  attachments OrderAttachment[]
  payments    Payment[]

  @@index([status])
  @@index([createdById])
  @@index([customerId])
  @@map("orders")
}

/// Sipariş verirken isim eşleşmesiyle otomatik bulunan/oluşturulan müşteri kaydı — "Müşteriler"
/// sayfasında toplam sipariş/ciro/tahsilat özetini ve geçmişini görmek için.
model Customer {
  id        String   @id @default(cuid())
  name      String   @unique
  contact   String?
  createdAt DateTime @default(now())

  // Muhasebe bir siparişe resmi fatura eklediğinde faturadan otomatik okunup
  // (OCR/metin çıkarımı, bkz. src/lib/invoice-extract.ts) doldurulan alanlar —
  // sadece o an boş olan alanlar yazılır, elle girilmiş/onaylanmış veri asla
  // otomatik ezilmez. Kullanıcı elle de düzenleyebilir (henüz UI'da yok).
  address   String?  @db.Text
  taxNumber String?
  taxOffice String?
  phone     String?
  email     String?
  // Adres geocode edilince (bkz. src/lib/geocode.ts, OpenStreetMap Nominatim — ücretsiz,
  // API anahtarı gerekmez) bir daha aynı adresi sormamak için burada önbelleğe alınır.
  // Panel'deki "Genel Görünüm" haritasında firma konumlarını göstermek için kullanılıyor.
  lat       Float?
  lng       Float?

  orders Order[]

  @@map("customers")
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productName String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  // Stok durumu: null = henüz kontrol edilmedi, true = Stokta Var, false = Stokta Yok
  // (bu durumda sipariş "Üretimde"ye düşer). Sadece iki seçenek — miktar bazlı stok
  // takibi bilerek yapılmıyor, kasıtlı olarak basit tutuldu.
  inStock     Boolean?

  @@map("order_items")
}

model OrderAttachment {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileId  String
  file    File   @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([orderId, fileId])
  @@map("order_attachments")
}

/// Bir siparişe karşı yapılan tahsilat kaydı — bir sipariş birden çok kısmi tahsilatla
/// (parça parça ödeme) kapanabilir; kalan bakiye toplam - tahsilatlar toplamından hesaplanır.
model Payment {
  id      String        @id @default(cuid())
  orderId String
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount  Decimal       @db.Decimal(12, 2)
  method  PaymentMethod @default(OTHER)
  note    String?       @db.Text
  paidAt  DateTime      @default(now()) // tahsilatın gerçekleştiği tarih (geçmişe dönük girilebilir)

  recordedById String
  recordedBy   User   @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("payments")
}

/// Kurum içi sohbet (BETA) — herkesin görebildiği kanallar + herkesin herkese
/// yazabildiği birebir (DM) mesajlaşma. Gerçek zamanlı iletim SSE (Server-Sent
/// Events) ile yapılır — ayrı bir WebSocket sunucusu gerektirmez, mevcut
/// standalone Next.js deploy'una dokunmaz (bkz. src/lib/chat-events.ts).
model ChatChannel {
  id          String   @id @default(cuid())
  name        String   @unique
  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation("ChatChannelCreatedBy", fields: [createdById], references: [id])

  messages ChatMessage[]

  @@map("chat_channels")
}

/// Bir mesaj ya bir kanala (channelId dolu) ya da birebir bir alıcıya
/// (recipientId dolu) aittir — ikisi asla aynı anda dolu/boş olmaz (uygulama
/// katmanında zorlanır, DB seviyesinde CHECK kısıtı Prisma/MySQL'de pratik değil).
/// content boş olabilir AMA fileId doluysa (ekli dosya kendisi "mesaj" sayılır) —
/// ikisi de boşsa gönderme reddedilir (bkz. /api/chat/messages).
model ChatMessage {
  id        String   @id @default(cuid())
  content   String   @db.Text
  createdAt DateTime @default(now())

  senderId String
  sender   User   @relation("ChatMessageSender", fields: [senderId], references: [id])

  channelId String?
  channel   ChatChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  recipientId String?
  recipient   User?   @relation("ChatMessageRecipient", fields: [recipientId], references: [id])

  // Sürücü'den var olan bir dosyayı eklemek veya PC'den yeni bir dosya yüklemek (önce normal
  // /api/files'a yüklenir, sonra buraya referans verilir) — ikisi de aynı alanı kullanır.
  // Dosyanın KENDİSİ silinirse (Drive'dan) mesajdaki referans da otomatik temizlenir (ekli
  // dosya kaybolur ama mesaj METNİ varsa mesaj durmaya devam eder).
  fileId String?
  file   File?   @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([channelId, createdAt])
  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, senderId, createdAt])
  @@map("chat_messages")
}

/// Bir kullanıcının bir kanalı/DM'i en son ne zaman okuduğu — sidebar'daki
/// "okunmamış" rozetini hesaplamak için. scopeKey: "channel:<id>" veya
/// "dm:<diğer kullanıcının id'si>" — tek bir tablo, tek bir unique index.
model ChatReadState {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopeKey   String
  lastReadAt DateTime @default(now())

  @@unique([userId, scopeKey])
  @@map("chat_read_states")
}
