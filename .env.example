DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/cdrive"
SESSION_SECRET="replace-with-a-long-random-string"
STORAGE_ROOT="./storage"
# Cdrive kökte DEĞİL bir alt-yolda barınıyorsa (ör. alanadiniz.com/cdrive), o alt-yolu
# buraya yazın. cPanel Node.js App'te "Application URL" alanına aynı yolu girin.
# Kökte (alanadiniz.com) barındıracaksanız boş bırakın: NEXT_BASE_PATH=""
NEXT_BASE_PATH="/cdrive"
# Opsiyonel: cPanel Cron Job'un POST /api/admin/cleanup çağırabilmesi için (bkz. README).
# CRON_SECRET="replace-with-a-long-random-string"

# Opsiyonel: OnlyOffice ile Word/Excel/PowerPoint düzenleme (bkz. README "Office belge düzenleme").
# APP_URL: Cdrive'ın Document Server'dan (ayrı bir VPS'ten) erişilebilir HERKESE AÇIK adresi.
# APP_URL="https://cdrive.alan-adiniz.com"
# ONLYOFFICE_URL: Document Server'ınızın adresi.
# ONLYOFFICE_URL="https://office.alan-adiniz.com"
# ONLYOFFICE_JWT_SECRET: Document Server'daki JWT_SECRET ile AYNI olmalı — tanımlı değilse
# Document Server istekleri imzasız kabul edilir (sadece geliştirme için kabul edilebilir).
# ONLYOFFICE_JWT_SECRET="replace-with-a-long-random-string"
# OFFICE_TOKEN_SECRET: tanımlı değilse SESSION_SECRET kullanılır, ayrı tutmak isterseniz verin.
# OFFICE_TOKEN_SECRET="replace-with-a-long-random-string"
