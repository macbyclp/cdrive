DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/cdrive"
SESSION_SECRET="replace-with-a-long-random-string"
STORAGE_ROOT="./storage"
# Cdrive kökte DEĞİL bir alt-yolda barınıyorsa (ör. alanadiniz.com/cdrive), o alt-yolu
# buraya yazın. cPanel Node.js App'te "Application URL" alanına aynı yolu girin.
# Kökte (alanadiniz.com) barındıracaksanız boş bırakın: NEXT_BASE_PATH=""
NEXT_BASE_PATH="/cdrive"
# Opsiyonel: cPanel Cron Job'un POST /api/admin/cleanup çağırabilmesi için (bkz. README).
# CRON_SECRET="replace-with-a-long-random-string"

# Opsiyonel: OnlyOffice ile Word/Excel/PowerPoint düzenleme (bkz. README "Office belge düzenleme").
# APP_URL: Cdrive'ın Document Server'dan (ayrı bir VPS'ten) erişilebilir HERKESE AÇIK adresi.
# APP_URL="https://cdrive.alan-adiniz.com"
# ONLYOFFICE_URL: Document Server'ınızın adresi.
# ONLYOFFICE_URL="https://office.alan-adiniz.com"
# ONLYOFFICE_JWT_SECRET: Document Server'daki JWT_SECRET ile AYNI olmalı — tanımlı değilse
# Document Server istekleri imzasız kabul edilir (sadece geliştirme için kabul edilebilir).
# ONLYOFFICE_JWT_SECRET="replace-with-a-long-random-string"
# OFFICE_TOKEN_SECRET: tanımlı değilse SESSION_SECRET kullanılır, ayrı tutmak isterseniz verin.
# OFFICE_TOKEN_SECRET="replace-with-a-long-random-string"

# Üretimde ZORUNLU: en az 32 karakterlik rastgele oturum imza anahtarı (yoksa uygulama başlamaz).
# SESSION_SECRET=""
# Opsiyonel ama ÖNERİLİR: 2FA anahtarlarını ve SMTP parolasını veritabanında şifreli (AES-256-GCM) saklar.
# Üretin: `openssl rand -hex 32`. DİKKAT: bu anahtarı kaybederseniz şifreli kayıtlar okunamaz (2FA'lı
# kullanıcılar giremez) — yedeğini güvenli bir yerde tutun. Tanımlı değilse sırlar eskisi gibi düz metin kalır;
# sonradan tanımlarsanız eski kayıtlar kullanıldıkça şifreliye yükseltilir.
# DATA_ENCRYPTION_KEY=""
# Opsiyonel: admin panelindeki "Yedekler" kartı için yedek dizini (salt-okunur).
# BACKUP_DIR="/backups"
# Opsiyonel: admin panelinden SMTP ayarlanmadıysa kullanılan geri-uyumluluk değişkenleri.
# SMTP_HOST=""
# SMTP_PORT="465"
# SMTP_USER=""
# SMTP_PASS=""
# MAIL_FROM=""
# Opsiyonel: OnlyOffice ile canlıda doğruladıktan sonra CSPyi ZORLA (varsayılan: yalnız Report-Only).
# CSP_ENFORCE="1"
# Opsiyonel: sunucu/istemci hatalarının JSON olarak POST edileceği webhook (Slack/n8n vb.); boşsa yalnız log.
# ERROR_WEBHOOK_URL=""
# Opsiyonel: eski ?password= paylaşım parametresini geçici olarak kabul et (varsayılan kapalı, önerilmez).
# SHARE_ALLOW_QUERY_PASSWORD="1"

# Uzaktan güncelleme (Yönetim → Güncelleme). Docker/VDS kurulumunda deploy/vds/docker-compose.yml
# bunları zaten ayarlar; elle çalıştırıyorsan updater sidecar'ını (deploy/vds/updater) ayrıca kur.
# UPDATER_URL="http://cdrive-updater:9000"
# UPDATER_TOKEN="openssl rand -hex 32 ile üretilmiş, updater ile AYNI belirteç"
# UPDATE_REPO="macbyclp/cdrive"   # güncellemenin izlendiği GitHub deposu
# UPDATE_BRANCH="main"            # izlenen dal
# GITHUB_TOKEN=""                 # opsiyonel: özel depo veya API hız sınırı için
# UPDATE_REQUIRE_VERIFIED="1"     # opsiyonel: yalnız GitHub'da imzalı (Verified) commit'ler kurulabilsin

# OnlyOffice kaydetme (callback) güvenliği: Document Server'ın bildirdiği indirme adresi yalnızca
# ONLYOFFICE_URL origin'inde olabilir (SSRF koruması). Document Server kaydetme adresini FARKLI bir
# origin'le (ör. dahili http://onlyoffice) bildiriyorsa, o origin'i virgülle burada belirtin.
# ONLYOFFICE_ALLOWED_ORIGINS="http://onlyoffice:80"
# ZIP yükleme: açılmış toplam boyut sınırı (varsayılan 2 GiB).
# ZIP_MAX_TOTAL_BYTES=2147483648

# Hız sınırı ve denetim kaydı için istemci IP'si: önünüzdeki GÜVENİLİR ters vekil sayısı (varsayılan 1:
# Caddy/nginx/Apache). Cloudflare + Caddy gibi iki vekil varsa 2. Vekil hiç yoksa (doğrudan erişim) 0 —
# o zaman X-Forwarded-For başlığı yok sayılır. Yanlış değer, saldırganın sahte IP ile sınırı aşmasına yol açar.
# TRUSTED_PROXY_HOPS="1"

# Tek bir dosya yüklemesinin diske yazabileceği en büyük boyut (bayt; varsayılan 2 GiB). Yönetici politikasındaki
# "en büyük dosya boyutu" ile bunun KÜÇÜĞÜ uygulanır. Dosyalar belleğe alınmadan doğrudan diske akıtılır.
# UPLOAD_MAX_BYTES=2147483648

# Parola hash maliyeti (bcrypt turu, 10–14; varsayılan 12 ≈ 350 ms). Eski hash'ler başarılı girişte otomatik yükseltilir.
# BCRYPT_ROUNDS="12"
