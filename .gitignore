# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
deploy.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# uploaded files (local disk storage)
/storage
/storage-test

# typescript
*.tsbuildinfo
next-env.d.ts
.commit-msg.txt

# Impeccable skill — bu oturuma özgü karar/inceleme artefaktları, tasarım kararları
# PRODUCT.md/DESIGN.md dosyalarında kalıcı olarak kayıtlı
.impeccable/
# Impeccable kurulumunun bıraktığı, bu makineye özgü mutlak yol içeren hook dosyaları
# (başka bir makinede/kullanıcıda anlamsız, kullanıcı adını sızdırır)
.claude/settings.local.json
.codex/hooks.json
